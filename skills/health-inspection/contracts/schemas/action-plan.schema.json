{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advisor business result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run_id","business_date","stage","status","summary","actions","not_recommended"],
  "properties": {
    "schema_version":{"type":"string","const":"2.0"},
    "run_id":{"type":"string","minLength":1},
    "business_date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "stage":{"type":"string","const":"advisor"},
    "status":{"type":"string","const":"completed"},
    "summary":{"type":"string","minLength":1},
    "actions":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["action_id","diagnosis_id","anomaly_ids","target_metric_ids","title","action_type","description","owner","collaborators","priority","expected_benefit","dependencies","time_window","reversible","acceptance_criteria","evidence_refs"],
        "properties":{
          "action_id":{"type":"string","minLength":1},
          "diagnosis_id":{"type":"string","minLength":1},
          "anomaly_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "target_metric_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "title":{"type":"string","minLength":1},
          "action_type":{"enum":["review_only","manual_adjustment"]},
          "description":{"type":"string","minLength":1},
          "owner":{"type":"string","minLength":1},
          "collaborators":{"type":"array","items":{"type":"string"}},
          "priority":{"type":"string","const":"P0"},
          "expected_benefit":{"type":"string","minLength":1},
          "dependencies":{"type":"array","items":{"type":"string"}},
          "time_window":{"type":"string","minLength":1},
          "reversible":{"type":"boolean"},
          "acceptance_criteria":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "adjustment_content":{"type":"string","minLength":1},
          "expected_improvement":{
            "type":"array","minItems":1,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["metric_id","direction","description"],
              "properties":{
                "metric_id":{"type":"string","minLength":1},
                "direction":{"enum":["increase","decrease","stabilize"]},
                "description":{"type":"string","minLength":1}
              }
            }
          },
          "observation_metrics":{
            "type":"object","additionalProperties":false,
            "required":["next_day","day_7"],
            "properties":{
              "next_day":{"type":"array","minItems":1,"description":"Only HI-xxx IDs already present in target_metric_ids; do not use channel or business-object names.","items":{"type":"string","pattern":"^HI-[0-9]{3}$"}},
              "day_7":{"type":"array","minItems":1,"description":"Only HI-xxx IDs already present in target_metric_ids; do not use channel or business-object names.","items":{"type":"string","pattern":"^HI-[0-9]{3}$"}}
            }
          }
        }
      }
    },
    "not_recommended":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["proposal","reason","alternative"],
        "properties":{
          "proposal":{"type":"string"},
          "reason":{"type":"string"},
          "alternative":{"type":"string"}
        }
      }
    }
  }
}
