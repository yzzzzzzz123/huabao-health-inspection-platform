{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 0 Data Operator bounded packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "business_date",
    "stage",
    "scope",
    "task",
    "connector_request",
    "expected_coverage",
    "command_plan",
    "policy_summary",
    "constraints",
    "hashes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "run_id": {"type": "string"},
    "business_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "stage": {"type": "string", "const": "data_operator"},
    "scope": {"type": "object"},
    "task": {"type": "string"},
    "connector_request": {
      "type": "object",
      "required": ["mode", "business_date", "timezone"],
      "properties": {
        "mode": {"type": "string"},
        "business_date": {"type": "string"},
        "timezone": {"type": "string"}
      }
    },
    "expected_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_count", "frequency", "dimension", "evaluation"],
      "properties": {
        "metric_count": {"type": "integer", "const": 37},
        "frequency": {
          "type": "object",
          "required": ["day", "week", "month"],
          "properties": {
            "day": {"type": "integer", "const": 18},
            "week": {"type": "integer", "const": 10},
            "month": {"type": "integer", "const": 9}
          }
        },
        "dimension": {
          "type": "object",
          "required": ["traffic", "conversion", "product"],
          "properties": {
            "traffic": {"type": "integer", "const": 12},
            "conversion": {"type": "integer", "const": 10},
            "product": {"type": "integer", "const": 15}
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluated", "partially_evaluated", "monitor_only", "rule_covered", "active_rules"],
          "properties": {
            "evaluated": {"type": "integer", "minimum": 0, "maximum": 37},
            "partially_evaluated": {"type": "integer", "minimum": 0, "maximum": 37},
            "monitor_only": {"type": "integer", "minimum": 0, "maximum": 37},
            "rule_covered": {"type": "integer", "minimum": 0, "maximum": 37},
            "active_rules": {"type": "integer", "minimum": 0, "maximum": 37}
          }
        }
      }
    },
    "command_plan": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["order", "command", "input", "output"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 4},
          "command": {"enum": ["data_layer", "calculate", "detect", "validate"]},
          "input": {"type": "string"},
          "output": {"type": "string"}
        }
      }
    },
    "policy_summary": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "hashes": {"type": "object"}
  }
}
