# Python/tool caches and machine-local environments.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/.venv/
.DS_Store

# Authoritative monorepo runtime state. The same anchored rules apply inside a
# linked worktree because that worktree also checks out the repository root.
/.huabao/
/.runtime/
/worktrees/*
!/worktrees/.gitkeep
/history/*
!/history/.gitkeep

# SQLite files are runtime data even if accidentally created outside .huabao.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Ignore every environment file except the tracked, secret-free Server
# contract. Real credentials must use deployment secret storage.
.env
**/.env
!/huabao-worktree-server/shared/.env
