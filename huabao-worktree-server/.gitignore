__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Machine-local Server state and fail-safe ignores for legacy/misplaced runtime
# paths. Authoritative state now lives at the parent monorepo root.
shared/.venv/
.huabao/
.runtime/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Linked worktrees and sealed archives belong at the parent root. Ignore any
# component-local copies so operational data can never enter a source snapshot.
worktrees/
history/

# The tracked environment contract is the only allowed .env file.
.env
**/.env
!shared/.env
