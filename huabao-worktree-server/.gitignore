__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Machine-local runtime state.
shared/.venv/
.huabao/
.runtime/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Linked worktrees and sealed archives are operational data, not source.
worktrees/*
!worktrees/.gitkeep
history/*
!history/.gitkeep

# Worktree-private receipts are ignored inside linked worktrees.
worktrees/*/.runtime/

# The tracked environment contract is the only allowed .env file.
.env
**/.env
!shared/.env
