__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# Machine-local Server state. This component owns the control state, dated
# linked-worktree placement, and sealed archive roots; Git itself still uses
# the single parent-monorepo common dir.
shared/.venv/
.huabao/
.runtime/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Each dated worktree is a complete parent-monorepo checkout even though its
# physical directory belongs to Server. Keep only the empty directory markers.
worktrees/*
!worktrees/.gitkeep
history/*
!history/.gitkeep

# The tracked environment contract is the only allowed .env file.
.env
**/.env
!shared/.env
