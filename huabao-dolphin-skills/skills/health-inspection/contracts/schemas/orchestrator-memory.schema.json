{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact orchestrator memory",
  "type": "object",
  "required": ["schema_version","run_id","facts","completed_stages","current_stage","decisions","pending","updated_at"],
  "properties": {
    "schema_version":{"type":"string","const":"1.0"},
    "run_id":{"type":"string"},
    "facts":{"type":"object"},
    "completed_stages":{"type":"array","items":{"type":"string"}},
    "current_stage":{"type":["string","null"]},
    "decisions":{"type":"array","items":{"type":"object"}},
    "pending":{"type":"array","items":{"type":"string"}},
    "updated_at":{"type":"string"}
  }
}
