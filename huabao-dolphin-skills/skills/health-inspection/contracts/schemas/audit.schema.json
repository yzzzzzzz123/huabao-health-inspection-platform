{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditor business result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run_id","business_date","stage","status","summary","logic_reviews","effect_reviews","contradictions"],
  "properties": {
    "schema_version":{"type":"string","const":"2.0"},
    "run_id":{"type":"string"},
    "business_date":{"type":"string"},
    "stage":{"type":"string","const":"auditor"},
    "status":{"type":"string","const":"completed"},
    "summary":{"type":"string"},
    "logic_reviews":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["review_id","action_id","diagnosis_id","anomaly_ids","target_metric_ids","verdict","anomaly_support","diagnosis_explanation","causality_assessment","recommendation_alignment","id_closure","manual_adjustment_assessment","rationale","caveats","evidence_refs"],
        "properties":{
          "review_id":{"type":"string"},
          "action_id":{"type":"string"},
          "diagnosis_id":{"type":"string"},
          "anomaly_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
          "target_metric_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
          "verdict":{"enum":["supported","supported_with_caveats","unsupported"]},
          "anomaly_support":{"type":"string"},
          "diagnosis_explanation":{"type":"string"},
          "causality_assessment":{"type":"string"},
          "recommendation_alignment":{"type":"string"},
          "id_closure":{"type":"string"},
          "manual_adjustment_assessment":{"type":"string"},
          "rationale":{"type":"string"},
          "caveats":{"type":"array","items":{"type":"string"}},
          "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}}
        }
      }
    },
    "effect_reviews":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["review_key","source_run_id","source_business_date","anomaly_id","anomaly_title","review_window","scheduled_review_date","observed_business_date","actual_interval_days","baseline_observed_date","metric_comparisons","anomaly_state","direction_alignment","deterministic_data_status","projection_sha256","conclusion","sustained_assessment","data_sufficiency","interpretation","attribution_limit"],
        "properties":{
          "review_key":{"type":"string"},
          "source_run_id":{"type":"string"},
          "source_business_date":{"type":"string"},
          "anomaly_id":{"type":"string","pattern":"^HI-[0-9]{3}$"},
          "anomaly_title":{"type":"string"},
          "review_window":{"enum":["next_day","day_7"]},
          "scheduled_review_date":{"type":"string"},
          "observed_business_date":{"type":"string"},
          "actual_interval_days":{"type":"integer","minimum":1},
          "baseline_observed_date":{"type":"string"},
          "metric_comparisons":{
            "type":"array","minItems":1,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["metric_id","metric_name","format","expected_direction","baseline","next_day","current","absolute_change","percentage_change","direction_aligned"],
              "properties":{
                "metric_id":{"type":"string"},
                "metric_name":{"type":"string"},
                "format":{"type":"string"},
                "expected_direction":{"enum":["increase","decrease","stabilize"]},
                "baseline":{
                  "type":"object","additionalProperties":false,
                  "required":["business_date","value","status","anomaly_active"],
                  "properties":{"business_date":{"type":"string"},"value":{"type":["number","null"]},"status":{"type":"string"},"anomaly_active":{"type":"boolean"}}
                },
                "next_day":{
                  "type":["object","null"],"additionalProperties":false,
                  "required":["business_date","value","status","anomaly_active"],
                  "properties":{"business_date":{"type":"string"},"value":{"type":["number","null"]},"status":{"type":"string"},"anomaly_active":{"type":"boolean"}}
                },
                "current":{
                  "type":"object","additionalProperties":false,
                  "required":["business_date","value","status","anomaly_active"],
                  "properties":{"business_date":{"type":"string"},"value":{"type":["number","null"]},"status":{"type":"string"},"anomaly_active":{"type":"boolean"}}
                },
                "absolute_change":{"type":["number","null"]},
                "percentage_change":{"type":["number","null"]},
                "direction_aligned":{"type":["boolean","null"]}
              }
            }
          },
          "anomaly_state":{"enum":["resolved","partially_resolved","persistent","not_present_at_baseline","insufficient_data"]},
          "direction_alignment":{"enum":["aligned","partially_aligned","unchanged","opposed","insufficient_data"]},
          "deterministic_data_status":{"enum":["sufficient","insufficient"]},
          "projection_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "conclusion":{"enum":["improved","partially_improved","unchanged","worsened","insufficient_data"]},
          "sustained_assessment":{"type":"string"},
          "data_sufficiency":{"type":"string"},
          "interpretation":{"type":"string"},
          "attribution_limit":{"type":"string","description":"必须字面包含‘回看期变化’和‘因果’，并明确只能视为回看期变化、不能直接宣称因果。"}
        }
      }
    },
    "contradictions":{"type":"array","items":{"type":"string"}}
  }
}
